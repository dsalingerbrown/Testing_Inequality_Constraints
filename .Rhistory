install.packages(c("quadprog", "MASS"))
library(quadprog)
library(MASS)
#' Simulate Chi-Bar-Square Weights
#'
#' @param omega Matrix. The covariance matrix of the constraints.
#' @param draws Integer. Number of Monte Carlo simulations (default 500).
#' @return A vector containing the estimated weights.
simulate_weights <- function(omega, draws = 500) {
# Determine the number of constraints (P)
P <- ncol(omega)
# 1. Prepare the inputs for the Quadratic Program
# The QP minimizes: -d^T b + 1/2 b^T D b  subject to A^T b >= b_0
# Here, Dmat is the inverse of our covariance matrix
omega_inv <- solve(omega)
Dmat <- omega_inv
# Amat and bvec set up the constraint that the solution must be >= 0
Amat <- diag(P)
bvec <- rep(0, P)
# Initialize a vector to count how many positive elements we get
counts <- rep(0, P + 1)
names(counts) <- paste0(0:P, "_positives")
# 2. Draw random vectors from N(0, Omega)
# The paper specifies drawing from a mean of zero
set.seed(123) # Set seed for reproducibility
Z_draws <- mvrnorm(n = draws, mu = rep(0, P), Sigma = omega)
# 3. The Monte Carlo Loop
for (i in 1:draws) {
# Grab the current random draw
Z <- Z_draws[i, ]
# The 'd' vector in the QP depends on the random draw
dvec <- omega_inv %*% Z
# Solve the QP
# We want to find the closest point in the positive space
sol <- solve.QP(Dmat = Dmat, dvec = as.vector(dvec), Amat = Amat, bvec = bvec)
# Extract the solution
theta <- sol$solution
# Count how many elements are strictly positive
# (Using 1e-6 to avoid floating-point rounding errors near zero)
num_positive <- sum(theta > 1e-6)
# Update our bucket counts (R is 1-indexed, so 0 positives goes in index 1)
counts[num_positive + 1] <- counts[num_positive + 1] + 1
}
# 4. Calculate the final weights (proportions)
weights <- counts / draws
return(weights)
}
# --- Test Run ---
# Let's create a dummy 3x3 covariance matrix to test it
dummy_omega <- matrix(c(1.0, 0.5, 0.2,
0.5, 1.0, 0.3,
0.2, 0.3, 1.0),
nrow = 3)
# Run the simulation
estimated_weights <- simulate_weights(dummy_omega, draws = 500)
print(estimated_weights)
